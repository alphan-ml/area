# Copy this file to .env and fill in real values. .env is git-ignored.
# Only the variables actually used by code that exists so far are listed;
# more are added here as each later task (W-B2, W-B4, W-B5) lands.

# W-B1: none needed. pull_open_payments.py talks to the public,
# unauthenticated CMS Open Payments DKAN API (openpaymentsdata.cms.gov and
# download.cms.gov) -- no key, no login. See CONTEXT.md's network-egress
# note if a build shell can't reach these hosts.

# W-B1 (tests/test_load_idempotent.py): a scratch PostgreSQL 16 database to
# run sql/001_schema.sql's real DDL against, same pattern as model-bench's
# TEST_DATABASE_URL. NOT a production secret. Without it, the live-DB test
# is skipped (reported as skipped, not pass) with a stated reason; CI sets
# this against a postgres:16 service container.
TEST_DATABASE_URL=

# W-B4 (the real live database `payments` gets loaded into and the agent
# queries at runtime, via the read-only `area_reader` role from
# sql/001_schema.sql).
DATABASE_URL=

# W-B4 (agent model calls; same provider layer as model-bench -- vendored,
# not a separate package). Adapter selection mirrors model-bench's
# MODELBENCH_ADAPTER.
AREA_ADAPTER=bedrock  # bedrock | anthropic_direct | openai_compatible
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# W-B1 (raw-pull storage): per the spec's non-negotiables, raw pulled pages
# are eventually archived to S3 as well as kept locally. No AWS S3 bucket
# exists yet (Gate 1) -- see CONTEXT.md's D-decision on this for what W-B1
# does in the meantime (local-disk raw storage only, documented, not S3).
AREA_RAW_S3_BUCKET=
